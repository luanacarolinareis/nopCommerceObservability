{
  "__inputs": [],
  "__requires": [],
  "title": "nopCommerce: Catalogue Observability",
  "uid": "nop-catalog-obs",
  "tags": ["nopcommerce", "catalog", "opentelemetry"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Products Published (rate)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "rate(catalog_products_published_total[5m])",
          "legendFormat": "published/s ({{publish_transition}})"
        }
      ]
    },
    {
      "id": 2,
      "title": "Products Inserted (rate)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "rate(catalog_products_inserted_total[5m])",
          "legendFormat": "inserted/s (published={{product_published}})"
        }
      ]
    },
    {
      "id": 3,
      "title": "Publish Pipeline Duration (p50 / p95 / p99)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(catalog_product_publish_duration_milliseconds_bucket[5m]))",
          "legendFormat": "p50 ms"
        },
        {
          "expr": "histogram_quantile(0.95, rate(catalog_product_publish_duration_milliseconds_bucket[5m]))",
          "legendFormat": "p95 ms"
        },
        {
          "expr": "histogram_quantile(0.99, rate(catalog_product_publish_duration_milliseconds_bucket[5m]))",
          "legendFormat": "p99 ms"
        }
      ]
    },
    {
      "id": 4,
      "title": "Cache Invalidations (rate by event type)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "rate(catalog_cache_invalidations_total[5m])",
          "legendFormat": "invalidations/s ({{entity_event_type}})"
        }
      ]
    },
    {
      "id": 5,
      "title": "Total Published vs Unpublished (counters)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 16, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "catalog_products_published_total",
          "legendFormat": "Published"
        },
        {
          "expr": "catalog_products_unpublished_total",
          "legendFormat": "Unpublished"
        }
      ]
    },
    {
      "id": 6,
      "title": "Trace Explorer (Jaeger)",
      "type": "traces",
      "datasource": {"type": "jaeger", "uid": "jaeger"},
      "gridPos": {"x": 6, "y": 16, "w": 18, "h": 10},
      "targets": [
        {
          "service": "nopcommerce",
          "operation": "admin.product.create"
        }
      ]
    }
  ]
}
