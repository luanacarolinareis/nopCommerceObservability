{
  "__inputs": [],
  "__requires": [],
  "title": "nopCommerce: Catalogue Observability",
  "uid": "nop-catalog-obs",
  "tags": ["nopcommerce", "catalog", "opentelemetry"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Products Published (rate)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (publish_transition) (rate(catalog_products_published_total{job=\"nopcommerce_via_collector\"}[5m]))",
          "legendFormat": "published/s ({{publish_transition}})"
        }
      ]
    },
    {
      "id": 2,
      "title": "Products Inserted (rate)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (product_published) (rate(catalog_products_inserted_total{job=\"nopcommerce_via_collector\"}[5m]))",
          "legendFormat": "inserted/s (published={{product_published}})"
        }
      ]
    },
    {
      "id": 3,
      "title": "Publish Pipeline Duration (p50 / p95 / p99)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(catalog_product_publish_duration_milliseconds_bucket{job=\"nopcommerce_via_collector\"}[5m])))",
          "legendFormat": "p50 ms"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(catalog_product_publish_duration_milliseconds_bucket{job=\"nopcommerce_via_collector\"}[5m])))",
          "legendFormat": "p95 ms"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(catalog_product_publish_duration_milliseconds_bucket{job=\"nopcommerce_via_collector\"}[5m])))",
          "legendFormat": "p99 ms"
        }
      ]
    },
    {
      "id": 4,
      "title": "Cache Invalidations (rate by event type)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "targets": [
        {
          "expr": "sum by (entity_event_type) (rate(catalog_cache_invalidations_total{job=\"nopcommerce_via_collector\"}[5m]))",
          "legendFormat": "invalidations/s ({{entity_event_type}})"
        }
      ]
    },
    {
      "id": 5,
      "title": "Total Published vs Unpublished (counters)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 16, "w": 6, "h": 4},
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Published"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Unpublished"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "expr": "sum(catalog_products_published_total{job=\"nopcommerce_via_collector\"}) or vector(0)",
          "legendFormat": "Published"
        },
        {
          "expr": "sum(catalog_products_unpublished_total{job=\"nopcommerce_via_collector\"}) or vector(0)",
          "legendFormat": "Unpublished"
        }
      ]
    },
    {
      "id": 7,
      "title": "Admin Publish Error Rate (%)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 6, "y": 16, "w": 18, "h": 4},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "100 * ((sum(rate(http_server_request_duration_seconds_count{job=\"nopcommerce_via_collector\",http_request_method=\"POST\",http_route=\"{area:exists}/{controller=Home}/{action=Index}/{id?}\",http_response_status_code=~\"4..|5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_server_request_duration_seconds_count{job=\"nopcommerce_via_collector\",http_request_method=\"POST\",http_route=\"{area:exists}/{controller=Home}/{action=Index}/{id?}\"}[5m])), 1e-9))",
          "legendFormat": "Admin POST route error rate"
        }
      ]
    },
    {
      "id": 6,
      "title": "Trace Lookup (Jaeger)",
      "type": "text",
      "gridPos": {"x": 0, "y": 20, "w": 24, "h": 10},
      "options": {
        "mode": "markdown",
        "content": "### Open traces in Jaeger\n\nThe embedded Grafana trace panel is intentionally disabled in this setup because it is less reliable than querying Jaeger directly during the demo.\n\nUse Jaeger UI instead:\n- URL: http://localhost:16686\n- Service: `nopcommerce`\n- Operation: `admin.product.create`\n\nExpected child spans:\n- `catalog.product.insert`\n- `catalog.cache.invalidation`\n\nIf the operation dropdown is empty, run the load test first and refresh Jaeger."
      }
    }
  ]
}
